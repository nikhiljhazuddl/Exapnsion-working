# Provider switch — "anthropic" (spec default) or "openai" (test runs only)
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=

# Model — auto-defaults per provider (claude-opus-4-7 / gpt-4o-mini). Override here.
MODEL=

RUN_COST_CAP_USD=5
MAX_CONCURRENCY=8
